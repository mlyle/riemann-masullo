namespace RiemannMasullo

variable {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]

/-- Tests supported on a fixed compact set form a closed subspace of Schwartz space. -/
theorem isClosedEmbedding_supportedToSchwartzCLM (K : Compacts E) :
    IsClosedEmbedding (supportedToSchwartzCLM ℂ (V := ℂ) K) := by
  let S : Submodule ℂ 𝓢(E, ℂ) :=
    { carrier := {f | ∀ x ∉ K, f x = 0}
      zero_mem' := fun _ _ ↦ rfl
      add_mem' := fun hf hg x hx ↦ by simp [hf x hx, hg x hx]
      smul_mem' := fun c f hf x hx ↦ by simp [hf x hx] }
  have hclosed : IsClosed (S : Set 𝓢(E, ℂ)) := by
    have he : (S : Set 𝓢(E, ℂ)) = ⋂ x ∈ (K : Set E)ᶜ, {f | f x = 0} := by
      ext f
      simp [S]
    rw [he]
    exact isClosed_biInter fun x _ ↦ isClosed_eq
      (((BoundedContinuousFunction.evalCLM ℂ x).comp
        (SchwartzMap.toBoundedContinuousFunctionCLM ℂ E ℂ)).continuous) continuous_const
  let J := supportedToSchwartzCLM ℂ (V := ℂ) K
  let L : S →ₗ[ℂ] 𝓓_{K}(E, ℂ) :=
    { toFun := fun f ↦ ContDiffMapSupportedIn.of_support_subset (f.val.smooth ⊤)
        fun x hx ↦ by_contra fun h ↦ hx (f.2 x h)
      map_add' := fun _ _ ↦ rfl
      map_smul' := fun _ _ ↦ rfl }
  have hL : Continuous L := by
    apply (ContDiffMapSupportedIn.withSeminorms ℂ _ _ _ _).continuous_of_continuous_comp
    intro n
    apply Seminorm.continuous_of_le (q := (schwartzSeminormFamily ℂ E ℂ (0, n)).comp S.subtype)
      (((schwartz_withSeminorms ℂ E ℂ).continuous_seminorm (0, n)).comp continuous_subtype_val)
    intro f
    exact (ContDiffMapSupportedIn.seminorm_top_le_iff ℂ (apply_nonneg _ _) n _).mpr
      fun x _ ↦ SchwartzMap.norm_iteratedFDeriv_le_seminorm ℂ f.val n x
  let R := J.codRestrict S fun f x hx ↦ image_eq_zero_of_notMem_tsupport fun h ↦ hx (f.tsupport_subset h)
  let e := ContinuousLinearEquiv.equivOfInverse R (⟨L, hL⟩ : S →L[ℂ] 𝓓_{K}(E, ℂ))
    (fun _ ↦ rfl) (fun _ ↦ rfl)
  exact (IsClosedEmbedding.subtypeVal hclosed).comp e.toHomeomorph.isClosedEmbedding

open scoped ComplexOrder in
/-- Complex scalar multiplication is continuous for the real LF topology, which is also
generated by complex seminorms. Adapted from the polynormability argument in
Ch05_ThetaZSpaces/Sec3a_Printed. -/
theorem testFunction_complex_polynormable
    {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E] :
    ContinuousSMul ℂ 𝓓((⊤ : Opens E), ℂ) ∧ PolynormableSpace ℂ 𝓓((⊤ : Opens E), ℂ) := by
  let L : 𝓓((⊤ : Opens E), ℂ) →L[ℂ] 𝓓((⊤ : Opens E), ℂ) :=
    TestFunction.postcompCLM (Complex.I • ContinuousLinearMap.id ℂ ℂ)
  have h : Continuous (fun z : ℂ × 𝓓((⊤ : Opens E), ℂ) ↦ z.1.re • z.2 + z.1.im • L z.2) :=
    ((Complex.continuous_re.comp continuous_fst).smul continuous_snd).add
      ((Complex.continuous_im.comp continuous_fst).smul (L.continuous.comp continuous_snd))
  let : ContinuousSMul ℂ 𝓓((⊤ : Opens E), ℂ) := ⟨h.congr fun z ↦ TestFunction.ext fun x ↦ by
    change (z.1.re : ℂ) * z.2 x + (z.1.im : ℂ) * (Complex.I * z.2 x) = z.1 * z.2 x
    rw [← mul_assoc, ← add_mul, Complex.re_add_im]⟩
  let : LocallyConvexSpace ℂ 𝓓((⊤ : Opens E), ℂ) :=
    .ofBasisZero ℂ _ _ _ (LocallyConvexSpace.convex_basis_zero ℝ 𝓓((⊤ : Opens E), ℂ))
      (fun _ hs ↦ convex_of_nonneg_surjective_algebraMap ℂ
        (fun _ hz ↦ RCLike.nonneg_iff_exists_ofReal.mp hz) hs.2)
  exact ⟨inferInstance, inferInstance⟩

/-- Test functions on a finite-dimensional real normed space are complete. Closed balls
give a countable strict inductive limit of complete fixed-support stages. -/
theorem completeSpace_testFunction [FiniteDimensional ℝ E] :
    CompleteSpace 𝓓((⊤ : Opens E), ℂ) := by
  classical
  obtain ⟨hs, hpoly⟩ := testFunction_complex_polynormable (E := E)
  let K (n : ℕ) : Compacts E := ⟨Metric.closedBall 0 n, isCompact_closedBall _ _⟩
  let X (n : ℕ) := 𝓓_{K n}(E, ℂ)
  let D := 𝓓((⊤ : Opens E), ℂ)
  have hm (n : ℕ) : K n ≤ K (n + 1) := Metric.closedBall_subset_closedBall (by exact_mod_cast n.le_succ)
  have he (C : Compacts E) : ∃ n, C ≤ K n := by
    obtain ⟨r, hr⟩ := C.isCompact.isBounded.subset_closedBall (0 : E)
    obtain ⟨n, hn⟩ := exists_nat_ge r
    exact ⟨n, hr.trans (Metric.closedBall_subset_closedBall hn)⟩
  let j (n : ℕ) : X n →L[ℂ] X (n + 1) := ContDiffMapSupportedIn.monoCLM ℂ
  let i (n : ℕ) : X n →L[ℂ] D := TestFunction.ofSupportedInCLM ℂ fun _ _ ↦ trivial
  have hc : ∀ n, CompleteSpace (X n) := fun n ↦ by
    let : CompleteSpace 𝓢(E, ℂ) := completeSpace_schwartzMap
    have h := isClosedEmbedding_supportedToSchwartzCLM (K n)
    exact (completeSpace_iff_isComplete_range
      (AddMonoidHom.isUniformInducing_of_isInducing h.isInducing)).mpr h.isClosed_range.isComplete
  have hj (n : ℕ) : IsEmbedding (j n) := by
    let J := supportedToSchwartzCLM ℂ (X := E) (V := ℂ)
    have hh : (J (K (n + 1))) ∘ j n = J (K n) := by
      funext f
      ext x
      change (ContDiffMapSupportedIn.monoCLM ℂ (K₂ := K (n + 1)) (n₂ := ⊤) f) x = f x
      simp [ContDiffMapSupportedIn.monoCLM_apply, hm]
    exact IsEmbedding.of_comp (j n).continuous (J (K (n + 1))).continuous
      (hh.symm ▸ (isClosedEmbedding_supportedToSchwartzCLM (K n)).isEmbedding)
  have ht : IsInjectiveLCLimit j i := by
    refine ⟨fun _ _ _ h ↦ ContDiffMapSupportedIn.ext fun x ↦ congrArg (fun f : D ↦ f x) h,
      fun n ↦ ?_, fun f ↦ ?_, ?_⟩
    · ext f x
      change (ContDiffMapSupportedIn.monoCLM ℂ (K₂ := K (n + 1)) (n₂ := ⊤) f) x = f x
      simp [ContDiffMapSupportedIn.monoCLM_apply, hm]
    · obtain ⟨n, hn⟩ := he ⟨tsupport (f : E → ℂ), f.hasCompactSupport⟩
      exact ⟨n, ContDiffMapSupportedIn.of_support_subset f.contDiff ((subset_tsupport _).trans hn), rfl⟩
    · change _ = (SeminormFamily.moduleFilterBasis
        (Subtype.val : {p : Seminorm ℂ D // ∀ n, Continuous (p ∘ i n)} → Seminorm ℂ D)).topology
      have hcond (p : Seminorm ℂ D) : (∀ n, Continuous (p ∘ i n)) ↔ Continuous p := by
        refine ⟨fun hp ↦ ?_, fun hp n ↦ hp.comp (i n).continuous⟩
        let e : ULift.{0} D ≃ₗ[ℂ] D := ULift.moduleEquiv
        let r := p.comp e.toLinearMap
        let nr := r.toSeminormedAddCommGroup
        let : SeminormedAddCommGroup (ULift.{0} D) := nr
        let : TopologicalSpace (ULift.{0} D) := nr.toUniformSpace.toTopologicalSpace
        let : NormedSpace ℂ (ULift.{0} D) := ⟨fun c f ↦ (map_smul_eq_mul r c f).le⟩
        let : NormedSpace ℝ (ULift.{0} D) := ⟨fun c f ↦ (map_smul_eq_mul (r.restrictScalars ℝ) c f).le⟩
        have hL : Continuous e.symm.toLinearMap := by
          refine (TestFunction.continuous_iff_continuous_comp _).2 fun C hC ↦ ?_
          obtain ⟨n, hn⟩ := he C
          let jC : 𝓓_{C}(E, ℂ) →L[ℂ] X n := ContDiffMapSupportedIn.monoCLM ℂ
          let J := e.symm.toLinearMap.comp (i n).toLinearMap
          have hJ : Continuous J := (norm_withSeminorms ℂ _).continuous_of_continuous_comp J fun _ ↦ hp n
          refine (hJ.comp jC.continuous).congr fun f ↦ congrArg e.symm (TestFunction.ext fun x ↦ ?_)
          change (ContDiffMapSupportedIn.monoCLM ℂ (K₂ := K n) (n₂ := ⊤) f) x = f x
          simp [ContDiffMapSupportedIn.monoCLM_apply, hn]
        exact continuous_norm.comp hL
      refine (PolynormableSpace.withSeminorms ℂ D).withSeminorms_eq.trans ?_
      apply congrArg (fun P : Seminorm ℂ D → Prop ↦
        (SeminormFamily.moduleFilterBasis (Subtype.val : Subtype P → Seminorm ℂ D)).topology)
      exact funext fun p ↦ propext (hcond p).symm
  have hn (n : ℕ) : @CompleteSpace (X n) (IsTopologicalAddGroup.rightUniformSpace (X n)) := by
    rw [IsUniformAddGroup.rightUniformSpace_eq]
    exact hc n
  let : ∀ n, PolynormableSpace ℂ (X n) := fun n ↦
    (ContDiffMapSupportedIn.withSeminorms ℂ E ℂ ⊤ (K n)).toPolynormableSpace
  exact (strictLCLimit_complete_nonmetrizable hn ht hj).1

/-- The continuous inclusion of compactly supported smooth tests into Schwartz space. -/
def testFunctionToSchwartzCLM : 𝓓((⊤ : Opens E), ℂ) →L[ℂ] 𝓢(E, ℂ) :=
  TestFunction.limitCLM ℂ (fun f ↦ f.hasCompactSupport.toSchwartzMap f.contDiff)
    (fun K _ ↦ supportedToSchwartzCLM ℂ K) (fun _ _ _ ↦ rfl)

/-- Multiplication by a compactly supported smooth function lands continuously in tests. -/
def schwartzToTestFunctionMulCLM (b : 𝓓((⊤ : Opens E), ℂ)) :
    𝓢(E, ℂ) →L[ℂ] 𝓓((⊤ : Opens E), ℂ) := by
  let K : Compacts E := ⟨tsupport (b : E → ℂ), b.hasCompactSupport⟩
  let M := SchwartzMap.smulLeftCLM ℂ (b : E → ℂ)
  let L : 𝓢(E, ℂ) →ₗ[ℂ] 𝓓_{K}(E, ℂ) :=
    { toFun := fun f ↦ ContDiffMapSupportedIn.of_support_subset ((M f).smooth ⊤)
        ((subset_tsupport _).trans ((SchwartzMap.tsupport_smulLeftCLM_subset _ f).trans inter_subset_right))
      map_add' := fun f g ↦ ContDiffMapSupportedIn.ext fun x ↦
        congrArg (fun h : 𝓢(E, ℂ) ↦ h x) (map_add M f g)
      map_smul' := fun c f ↦ ContDiffMapSupportedIn.ext fun x ↦
        congrArg (fun h : 𝓢(E, ℂ) ↦ h x) (map_smul M c f) }
  have hL : Continuous L := by
    apply (ContDiffMapSupportedIn.withSeminorms ℂ _ _ _ _).continuous_of_continuous_comp
    intro n
    apply Seminorm.continuous_of_le (q := (schwartzSeminormFamily ℂ E ℂ (0, n)).comp M.toLinearMap)
      (((schwartz_withSeminorms ℂ E ℂ).continuous_seminorm (0, n)).comp M.continuous)
    intro f
    exact (ContDiffMapSupportedIn.seminorm_top_le_iff ℂ (apply_nonneg _ _) n _).mpr
      fun x _ ↦ SchwartzMap.norm_iteratedFDeriv_le_seminorm ℂ (M f) n x
  exact (TestFunction.ofSupportedInCLM ℂ (fun _ _ ↦ trivial)).comp (⟨L, hL⟩ : _ →L[ℂ] 𝓓_{K}(E, ℂ))

/-- The cutoff operator acts by pointwise multiplication. -/
theorem schwartzToTestFunctionMulCLM_apply (b : 𝓓((⊤ : Opens E), ℂ)) (f : 𝓢(E, ℂ)) (x : E) :
    schwartzToTestFunctionMulCLM b f x = b x * f x :=
  SchwartzMap.smulLeftCLM_apply_apply (b.hasCompactSupport.hasTemperateGrowth b.contDiff) _ _

end RiemannMasullo
